{
  "name": "moonbase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.ts",
    "check": "npm run test:unit && npm run test:online && node scripts/check-architecture.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "golden": "node scripts/golden-replay.mjs --check",
    "typecheck": "tsc -b",
    "architecture": "node scripts/check-architecture.mjs",
    "test:unit": "vitest run tests/engine tests/session",
    "test:online": "vitest run tests/online",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/online.spec.ts e2e/online-roles.spec.ts e2e/sound.spec.ts",
    "perf": "playwright test e2e/perf.spec.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
