{
  "verdicts": [
    {"id": "perfect", "when": ["won", "healthHigh", "!anyShortage", "!blackoutAtNight", "!blackoutByDay"]},
    {"id": "won", "when": ["won"]},
    {"id": "lost-late", "when": ["lost", "reachedNight"]},
    {"id": "lost", "when": ["lost"]}
  ],
  "rules": [
    {"id": "flare-worked", "kind": "hurt", "when": ["flareWorked"], "hint": "flare"},
    {"id": "flare-no-shelter", "kind": "hurt", "when": ["flareHidNoShelter"], "hint": "flare"},
    {"id": "breakdown-ignored", "kind": "hurt", "when": ["breakdownIgnored"], "hint": "water"},
    {"id": "no-builds", "kind": "hurt", "when": ["noBuilds"]},
    {"id": "food-no-greenhouse", "kind": "hurt", "when": ["ranOutFood", "!builtGreenhouse"]},
    {"id": "food-late-greenhouse", "kind": "hurt", "when": ["ranOutFood", "builtGreenhouse"]},
    {"id": "oxygen-out", "kind": "hurt", "when": ["ranOutOxygen"]},
    {"id": "water-out", "kind": "hurt", "when": ["ranOutWater"], "hint": "water"},
    {"id": "night-no-battery", "kind": "hurt", "when": ["blackoutAtNight", "!batteryBeforeNight"], "hint": "night"},
    {"id": "night-weak-battery", "kind": "hurt", "when": ["blackoutAtNight", "batteryBeforeNight"], "hint": "night"},
    {"id": "day-blackout", "kind": "hurt", "when": ["blackoutByDay"]},
    {"id": "flare-shelter", "kind": "helped", "when": ["flareHidInShelter"], "hint": "flare"},
    {"id": "breakdown-repaired", "kind": "helped", "when": ["breakdownRepaired"], "hint": "water"},
    {"id": "night-survived", "kind": "helped", "when": ["reachedNight", "batteryBeforeNight", "!blackoutAtNight"], "hint": "night"},
    {"id": "greenhouse-fed", "kind": "helped", "when": ["builtGreenhouse", "!ranOutFood"]},
    {"id": "crew-healthy", "kind": "helped", "when": ["won", "healthHigh"]},
    {"id": "tasks-done", "kind": "helped", "when": ["tasksMostlyDone"]},
    {"id": "tasks-missed", "kind": "hurt", "when": ["tasksMostlyMissed"]},
    {"id": "real-flare", "kind": "fact", "when": ["flareHappened"], "source": "flare"}
  ]
}
